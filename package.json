{
  "name": "@c0va23/surrealdb.node",
  "version": "1.0.0-beta.11",
  "author": {
    "name": "Raphael Darley",
    "email": "raphael.darley@surrealdb.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surrealdb/surrealdb.node.git"
  },
  "description": "Node.js driver for SurrealDB",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "surrealdb.node",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-linux-android",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "aarch64-pc-windows-msvc",
        "armv7-unknown-linux-gnueabihf",
        "x86_64-unknown-linux-musl",
        "x86_64-unknown-freebsd",
        "i686-pc-windows-msvc",
        "armv7-linux-androideabi",
        "universal-apple-darwin"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/embedded.d.ts",
      "default": "./lib/embedded.js"
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.3",
    "ava": "^5.1.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@c0va23/surrealdb": "^1.3.6"
  },
  "peerDependencies": {
    "@c0va23/surrealdb": "^1.3.6"
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "node move_artifacts.js",
    "build": "bash ./build.sh",
    "build:debug": "napi build --platform && bash ./fix-deps.sh && tsc",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "npx tsx test.ts",
    "universal": "napi universal",
    "version": "napi version",
    "ts-compile": "pnpm i typescript && tsc --version && tsc"
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "npm",
    "surrealdb.node.*.node"
  ],
  "optionalDependencies": {
    "@c0va23/surrealdb.node-win32-x64-msvc": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-darwin-x64": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-linux-x64-gnu": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-darwin-arm64": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-android-arm64": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-linux-arm64-gnu": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-linux-arm64-musl": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-win32-arm64-msvc": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-linux-arm-gnueabihf": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-linux-x64-musl": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-freebsd-x64": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-win32-ia32-msvc": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-android-arm-eabi": "1.0.0-beta.11",
    "@c0va23/surrealdb.node-darwin-universal": "1.0.0-beta.11"
  }
}